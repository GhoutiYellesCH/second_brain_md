{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Brain",
  "version": "1.0.0",
  "identifier": "com.ghoutiyelles.secondbrain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Second Brain - Obsidian Vault & Synapses",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Obsidian-Compatible Markdown Vault & Synapses Graph",
    "longDescription": "Second Brain is an offline-first, Obsidian-compatible knowledge base and markdown reader with configurable asset storage, full Obsidian editor modes, and an interactive force-directed Synapses Graph.",
    "publisher": "Ghouti Yelles Chaouche",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ],
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
